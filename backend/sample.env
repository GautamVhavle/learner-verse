# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnerverse
SECRET_KEY=change-me-to-a-random-64-char-string

# === Auth ===
# Set to true for local dev (skips Clerk auth, auto-creates a default user)
SINGLE_USER_MODE=true
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ISSUER=

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# === Storage ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# === MinIO (S3-compatible object storage) ===
# Matches the defaults in docker-compose.yml
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learnerverse
MINIO_SECURE=false
