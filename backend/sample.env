# === Database ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnerverse
SECRET_KEY=change-me-to-a-random-64-char-string

# === Auth ===
# Set to true for local dev (skips auth, auto-creates a default user)
SINGLE_USER_MODE=true
# Required in production when SINGLE_USER_MODE=false
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DEFAULT_OG_IMAGE_URL=https://learnerverse.xyz/preview.png

# === AI ===
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# === Storage ===
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# === MinIO (S3-compatible object storage) ===
# Matches the defaults in docker-compose.yml
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learnerverse
MINIO_SECURE=false

# === Payment Gateway ===
# Set to true only when the private payment submodule is present.
# When false (default), all users get Pro features for free.
PAYMENT_GATEWAY_ENABLED=false

# === Observability ===
# Set to your Sentry DSN in production to enable error tracking.
# Leave empty for local development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
