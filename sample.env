# ============================================================
# LearnerVerse - Root environment variables
# Copy this file to .env and fill in the values.
# Both the backend and the Vite frontend read from this file.
# ============================================================

# === Backend ===

# PostgreSQL connection string (asyncpg format)
# For Supabase session pooler use the format shown below and
# add ?prepared_statement_cache_size=0 to work through PgBouncer.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname?prepared_statement_cache_size=0

# Random 64-character secret - used for internal signing.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── AI / LLM ──────────────────────────────────────────────

# OpenRouter API key (primary AI provider)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use via OpenRouter (default: free Nemotron)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google Gemini fallback - used automatically when OpenRouter returns 429
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── Auth ──────────────────────────────────────────────────

# Set to true to skip Auth0 entirely (local dev / single-user self-host)
SINGLE_USER_MODE=false

# Auth0 credentials - required when SINGLE_USER_MODE=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-backend-client-id
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# ── Server ────────────────────────────────────────────────

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── MCP / production rollout controls ──────────────────────
# MCP HTTP is served by the FastAPI app itself at /mcp/ (the same public
# hostname and port as the REST API). Port 8001 is only a local convention.
MCP_ENABLED=true
MCP_HTTP_ENABLED=true
MCP_STDIO_ENABLED=true
# Enable only after Redis, outbox dispatcher, jobs worker, renderer and private
# asset storage are deployed and healthy. FastAPI Cloud's web service alone is
# not the complete build-worker stack.
PRODUCTION_PIPELINE_ENABLED=false
GENERATED_ASSETS_ENABLED=true
MCP_TASKS_EXTENSION_ENABLED=false
# Canonical hosted configuration. Replace these three together when self-hosting.
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*,learner-verse.fastapicloud.dev
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=https://learner-verse.fastapicloud.dev/mcp/
MCP_ISSUER_URL=https://learner-verse.fastapicloud.dev/
# Set strong distinct values in production; never commit real values.
MCP_PAT_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
CREDENTIAL_ENCRYPTION_KEYS=
PRODUCTION_MAX_CONCURRENT_JOBS=3
PRODUCTION_MAX_TOKENS_PER_USER=10
PRODUCTION_ASSET_RETENTION_DAYS=30
PRODUCTION_PREVIEW_RETENTION_DAYS=7

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://learnerverse.xyz

# ── Storage (Supabase) ────────────────────────────────────

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Supabase project URL and service-role key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...your-supabase-service-role-key
SUPABASE_BUCKET=thumbnails

# ── Superadmin ────────────────────────────────────────────

# Comma-separated email addresses granted superadmin access
SUPERADMIN_EMAILS=admin@example.com

# ── Error tracking (optional) ─────────────────────────────

# Sentry DSN - leave blank to disable
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx

# ── Payment Gateway (optional) ────────────────────────────

# Set to true only for the hosted SaaS deployment.
# When false (default) all users get full access - no paywalls shown.
PAYMENT_GATEWAY_ENABLED=false
VITE_PAYMENT_GATEWAY_ENABLED=false

# Razorpay credentials - only required when PAYMENT_GATEWAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me-razorpay-key-secret
RAZORPAY_MONTHLY_AMOUNT=9900
RAZORPAY_YEARLY_AMOUNT=99900
RAZORPAY_PLAN_ID_MONTHLY=plan_xxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID_YEARLY=plan_xxxxxxxxxxxxxxxx
# Generate with: openssl rand -hex 16
RAZORPAY_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-16

# ============================================================
# === Frontend (Vite) ===
# These VITE_* variables are baked into the browser bundle.
# Never put secrets here.
# ============================================================

# Backend API base URL as seen from the browser
VITE_API_BASE_URL=https://learner-verse.fastapicloud.dev/api/v1

# Set to true to skip Auth0 in the browser (matches SINGLE_USER_MODE above)
VITE_SINGLE_USER_MODE=false

# Auth0 SPA credentials - required when VITE_SINGLE_USER_MODE=false
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Comma-separated superadmin emails (client-side UX guard only)
VITE_SUPERADMIN_EMAILS=admin@example.com

# Google Search Console verification token (optional)
# VITE_GOOGLE_SITE_VERIFICATION=your-token-here

# Public site URL used for share links (optional, used in prod)
# VITE_PUBLIC_SITE_URL=https://learnerverse.xyz
