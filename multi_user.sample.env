# ─────────────────────────────────────────────────────────────
# LearnerVerse - Multi-User Mode Environment
#
# Copy this file to .env.multi-user and fill in your values:
#   cp multi_user.sample.env .env.multi-user
#
# IMPORTANT: Before starting, add http://localhost:3000 to your
# Auth0 application's Allowed Callback URLs, Allowed Logout URLs,
# and Allowed Web Origins in the Auth0 dashboard.
#
# Then start with:
#   docker compose --env-file .env.multi-user \
#     -f docker-compose.multi-user.yml up --build
# ─────────────────────────────────────────────────────────────

# === Database (Postgres container) ===
POSTGRES_USER=learnerverse
POSTGRES_PASSWORD=change-me-generated-by-self-host-setup
POSTGRES_DB=learnerverse

# === Backend ===
DATABASE_URL=postgresql+asyncpg://learnerverse:change-me-generated-by-self-host-setup@db:5432/learnerverse
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Public port exposed by the Nginx frontend
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
SENTRY_ENVIRONMENT=production

# MCP is mounted on the backend at /mcp/; no separate public port is needed.
MCP_ENABLED=true
MCP_HTTP_ENABLED=true
MCP_STDIO_ENABLED=true
# Experimental generated-video pipeline. Keep false: the supported self-host
# stack provides the complete LMS, but not the unfinished renderer pipeline.
PRODUCTION_PIPELINE_ENABLED=false
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=http://localhost:3000/mcp/
MCP_ISSUER_URL=http://localhost:3000/
MCP_PAT_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
# Fernet key for encrypting provider credentials stored through MCP settings.
# Generated automatically by ./scripts/self-host.sh setup multi.
CREDENTIAL_ENCRYPTION_KEYS=change-me-generated-by-self-host-setup

# Auth - Auth0 credentials (required)
SINGLE_USER_MODE=false
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-backend-client-id
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER=https://your-tenant.us.auth0.com/

# Storage - leave blank to use local disk, or fill in for Supabase
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=thumbnails

# AI - optional, enables LiVi AI tutor chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Payment - disabled (all features unlocked for free)
PAYMENT_GATEWAY_ENABLED=false

# Superadmin - comma-separated emails with dashboard access
SUPERADMIN_EMAILS=

# Observability - optional
SENTRY_DSN=

# === Frontend (baked into the static build) ===
# Keep this relative. Nginx proxies it to the backend, so browsers on other
# computers never try to contact their own localhost.
VITE_API_BASE_URL=/api/v1
VITE_SINGLE_USER_MODE=false
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_PAYMENT_GATEWAY_ENABLED=false
# Comma-separated superadmin emails (client-side UX guard only)
VITE_SUPERADMIN_EMAILS=
# Public browser URL used for share links
VITE_PUBLIC_SITE_URL=http://localhost:3000
