# ─────────────────────────────────────────────────────────────
# LearnerVerse — Single-User Mode Environment
#
# Copy this file to .env.single-user and customise as needed:
#   cp single_mode.sample.env .env.single-user
#
# Then start with:
#   docker compose -f docker-compose.single-user.yml up --build
# ─────────────────────────────────────────────────────────────

# === Database (Postgres container) ===
POSTGRES_USER=learnerverse
POSTGRES_PASSWORD=learnerverse
POSTGRES_DB=learnerverse
# Port exposed on the host (change if 5433 is already in use)
POSTGRES_HOST_PORT=5433

# === Backend ===
DATABASE_URL=postgresql+asyncpg://learnerverse:learnerverse@db:5432/learnerverse
SECRET_KEY=single-user-local-dev-key-change-me

# Auth — single-user mode (no Auth0 needed)
SINGLE_USER_MODE=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Storage — local disk (no Supabase)
UPLOAD_DIR=/app/uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI — paste your API key to enable LiVi chat (optional)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Payment — disabled (all features unlocked for free)
PAYMENT_GATEWAY_ENABLED=false

# Superadmin — auto-configured in single-user mode
SUPERADMIN_EMAILS=

# Observability — disabled for local
SENTRY_DSN=

# === Frontend (baked into the static build) ===
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SINGLE_USER_MODE=true
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_PAYMENT_GATEWAY_ENABLED=false
