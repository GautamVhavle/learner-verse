# ─────────────────────────────────────────────────────────────
# LearnerVerse - Single-User Mode Environment
#
# Copy this file to .env.single-user and customise as needed:
#   cp single_user.sample.env .env.single-user
#
# Then start with:
#   docker compose -f docker-compose.single-user.yml up --build
# ─────────────────────────────────────────────────────────────

# === Database (Postgres container) ===
POSTGRES_USER=learnerverse
POSTGRES_PASSWORD=change-me-generated-by-self-host-setup
POSTGRES_DB=learnerverse

# === Backend ===
DATABASE_URL=postgresql+asyncpg://learnerverse:change-me-generated-by-self-host-setup@db:5432/learnerverse
# Generated automatically by ./scripts/self-host.sh setup single
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Auth - single-user mode (no Auth0 needed)
SINGLE_USER_MODE=true

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
SENTRY_ENVIRONMENT=local

# MCP is mounted on the backend at /mcp/; no separate public port is needed.
MCP_ENABLED=true
MCP_HTTP_ENABLED=true
MCP_STDIO_ENABLED=true
PRODUCTION_PIPELINE_ENABLED=false
MCP_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:*,localhost,localhost:*
MCP_ALLOWED_ORIGINS=
MCP_PUBLIC_URL=http://localhost:3000/mcp/
MCP_ISSUER_URL=http://localhost:3000/
MCP_PAT_SIGNING_KEY=change-me-generate-with-openssl-rand-hex-32
CREDENTIAL_ENCRYPTION_KEYS=change-me-generated-by-self-host-setup

# Storage - local disk (no Supabase)
UPLOAD_DIR=/app/uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI - paste your API key to enable LiVi chat (optional)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Payment - disabled (all features unlocked for free)
PAYMENT_GATEWAY_ENABLED=false

# Superadmin - auto-configured in single-user mode
SUPERADMIN_EMAILS=

# Observability - disabled for local
SENTRY_DSN=

# === Frontend (baked into the static build) ===
VITE_API_BASE_URL=/api/v1
VITE_SINGLE_USER_MODE=true
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_PAYMENT_GATEWAY_ENABLED=false
VITE_PUBLIC_SITE_URL=http://localhost:3000
