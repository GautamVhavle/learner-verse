# ── Frontend build for single-user / self-hosted mode ─────
# Build context must be the project root so private/ symlinks resolve.
#
# Stage 1: Build
FROM node:22-alpine AS build

WORKDIR /app

# Install deps first (cached layer)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source
COPY frontend/ .

# Copy private subscription files (resolve symlinks)
COPY private/frontend/src/hooks/useSubscription.ts src/hooks/useSubscription.ts
COPY private/frontend/src/components/subscription/ProGateDialog.tsx src/components/subscription/ProGateDialog.tsx
COPY private/frontend/src/components/subscription/CongratulationsDialog.tsx src/components/subscription/CongratulationsDialog.tsx
COPY private/frontend/src/components/home/PricingSection.tsx src/components/home/PricingSection.tsx
COPY private/frontend/src/pages/PricingPage.tsx src/pages/PricingPage.tsx
COPY private/frontend/src/pages/RenewPage.tsx src/pages/RenewPage.tsx
COPY private/frontend/src/types/subscription.ts src/types/subscription.ts

# Build-time env vars baked into the static bundle.
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_SINGLE_USER_MODE=true
ARG VITE_AUTH0_DOMAIN=""
ARG VITE_AUTH0_CLIENT_ID=""
ARG VITE_AUTH0_AUDIENCE=""
ARG VITE_PAYMENT_GATEWAY_ENABLED=false

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SINGLE_USER_MODE=$VITE_SINGLE_USER_MODE
ENV VITE_AUTH0_DOMAIN=$VITE_AUTH0_DOMAIN
ENV VITE_AUTH0_CLIENT_ID=$VITE_AUTH0_CLIENT_ID
ENV VITE_AUTH0_AUDIENCE=$VITE_AUTH0_AUDIENCE
ENV VITE_PAYMENT_GATEWAY_ENABLED=$VITE_PAYMENT_GATEWAY_ENABLED

RUN npm run build

# ── Stage 2: Serve with nginx ────────────────────────────
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
