# === API ===
VITE_API_BASE_URL=http://localhost:8000/api/v1

# === SEO ===
VITE_GOOGLE_SITE_VERIFICATION=

# === Public Sharing ===
VITE_PUBLIC_SITE_URL=https://learnerverse.xyz

# === Auth ===
# Set to true for local dev (bypasses auth on the frontend)
VITE_SINGLE_USER_MODE=true
# Required in production when SINGLE_USER_MODE=false
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# === Payment Gateway ===
# Set to true only when Razorpay payment integration is available.
# When false (default), all users get Pro features for free.
VITE_PAYMENT_GATEWAY_ENABLED=false
